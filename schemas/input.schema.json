{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "nodes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "tenant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "cloud": {
            "type": "string",
            "enum": [
              "aws",
              "azure",
              "gcp"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "identity",
              "group",
              "role",
              "resource"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "tenant",
          "cloud",
          "kind",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "tenant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "relation": {
            "type": "string",
            "enum": [
              "member_of",
              "can_assume",
              "grant"
            ]
          },
          "effect": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "actions": {
            "default": [],
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "conditions": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "unresolved"
            ]
          },
          "constraints": {
            "type": "object",
            "properties": {
              "resource_patterns": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "excluded_actions": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "plane": {
                "type": "string",
                "enum": [
                  "control",
                  "data"
                ]
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "pointer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "collected_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "source",
              "pointer",
              "collected_at",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tenant",
          "from",
          "to",
          "relation",
          "effect",
          "actions",
          "conditions",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "collection": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "aws",
            "azure",
            "gcp"
          ]
        },
        "scope": {
          "type": "string",
          "maxLength": 4096
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "issues": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "api_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      },
      "required": [
        "provider",
        "scope",
        "collected_at",
        "status",
        "issues",
        "snapshot_sha256",
        "api_calls"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plane": {
          "type": "string",
          "enum": [
            "control",
            "data"
          ]
        },
        "max_depth": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "principal",
        "resource",
        "action",
        "max_depth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tenant",
    "nodes",
    "edges",
    "query"
  ],
  "additionalProperties": false
}
