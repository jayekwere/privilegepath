{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nodes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tenant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cloud": {
            "type": "string",
            "enum": [
              "aws",
              "azure",
              "gcp"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "identity",
              "group",
              "role",
              "resource"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "tenant",
          "cloud",
          "kind",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tenant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "relation": {
            "type": "string",
            "enum": [
              "member_of",
              "can_assume",
              "grant"
            ]
          },
          "effect": {
            "default": "allow",
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "actions": {
            "default": [],
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "conditions": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "pointer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "collected_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "source",
              "pointer",
              "collected_at",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tenant",
          "from",
          "to",
          "relation",
          "effect",
          "actions",
          "conditions",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "max_depth": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "principal",
        "resource",
        "action",
        "max_depth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "tenant",
    "nodes",
    "edges",
    "query"
  ],
  "additionalProperties": false
}
